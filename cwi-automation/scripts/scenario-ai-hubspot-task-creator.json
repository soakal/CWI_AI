        "value": "{{env.HUBSPOT_OWNER_ID_BRIAN}}"
      },
      "metadata": {
        "designer": { "x": 1200, "y": 300 }
      }
    },
    {
      "id": 8,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 1500, "y": 0 }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 9,
              "module": "builtin:BasicFilter",
              "version": 1,
              "parameters": {},
              "mapper": {},
              "metadata": {
                "designer": { "x": 1800, "y": -600 }
              },
              "filter": {
                "name": "Stage = REPLIED",
                "conditions": [
                  [
                    {
                      "a": "{{1.body.propertyValue}}",
                      "b": "{{env.HUBSPOT_STAGE_REPLIED}}",
                      "o": "text:equal"
                    }
                  ]
                ]
              }
            },
            {
              "id": 10,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://api.hubapi.com/crm/v3/objects/tasks",
                "method": "POST",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer {{env.HUBSPOT_PRIVATE_APP_TOKEN}}"
                  },
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "bodyType": "raw",
                "contentType": "application/json",
                "body": "{\"properties\":{\"hs_task_subject\":\"Schedule discovery call with {{5.contactName}}\",\"hs_task_type\":\"CALL\",\"hs_timestamp\":\"{{formatDate(addDays(now; 1); 'x'; 'America/New_York')}}\",\"hubspot_owner_id\":\"{{7.ownerIdBrian}}\"}}",
                "timeout": 30,
                "followRedirects": true,
                "compress": true,
                "parseResponse": true
              },
              "metadata": {
                "designer": { "x": 2100, "y": -600 },
                "restore": {
                  "expect": {
                    "method": { "label": "POST" }
                  }
                }
              }
            },
            {
              "id": 11,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://api.hubapi.com/crm/v3/associations/tasks/{{10.data.id}}/deals/{{6.dealId}}",
                "method": "PUT",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer {{env.HUBSPOT_PRIVATE_APP_TOKEN}}"
                  },
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "bodyType": "raw",
                "contentType": "application/json",
                "body": "{\"associationType\":\"task_to_deal\"}",
                "timeout": 30,
                "followRedirects": true,
                "compress": true,
                "parseResponse": true
              },
              "metadata": {
                "designer": { "x": 2400, "y": -600 },
                "restore": {
                  "expect": {
                    "method": { "label": "PUT" }
                  }
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 12,
              "module": "builtin:BasicFilter",
              "version": 1,
              "parameters": {},
              "mapper": {},
              "metadata": {
                "designer": { "x": 1800, "y": -200 }
