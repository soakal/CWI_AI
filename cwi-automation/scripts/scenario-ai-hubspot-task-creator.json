                ],
                "bodyType": "raw",
                "contentType": "application/json",
                "body": "{\"properties\":{\"hs_task_subject\":\"Add {{5.contactName}} to re-engagement list in 30 days\",\"hs_task_type\":\"TODO\",\"hs_timestamp\":\"{{formatDate(addDays(now; 30); 'x'; 'America/New_York')}}\",\"hubspot_owner_id\":\"{{7.ownerIdBrian}}\"}}",
                "timeout": 30,
