              "version": 1,
              "parameters": {},
              "mapper": {},
              "metadata": {
                "designer": { "x": 1800, "y": 600 }
              },
              "filter": {
                "name": "Stage = CLOSED_LOST",
                "conditions": [
                  [
                    {
                      "a": "{{1.body.propertyValue}}",
                      "b": "{{env.HUBSPOT_STAGE_CLOSED_LOST}}",
                      "o": "text:equal"
                    }
                  ]
