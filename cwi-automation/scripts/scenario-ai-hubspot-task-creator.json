  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us1.make.com",
    "notes": "Fires on HubSpot deal property change webhook when dealstage changes. Fetches full deal details and associated contact name from HubSpot. Routes on dealstage value via a 4-route Router. Route 1 (HUBSPOT_STAGE_REPLIED): creates a CALL task due in 1 day — Schedule discovery call with [contact], owner = Brian. Route 2 (HUBSPOT_STAGE_CALL_BOOKED): creates a TODO task due in 2 days — Send proposal to [contact], owner = Brian. Route 3 (HUBSPOT_STAGE_PROPOSAL_SENT): creates an EMAIL task due in 3 days — Follow up on proposal — [contact], owner = Brian; also sends alert email via Resend to env.ALERT_EMAIL from env.CWI_ALERT_FROM_ADDRESS. Route 4 (HUBSPOT_STAGE_CLOSED_LOST): creates a TODO task due in 30 days — Add [contact] to re-engagement list, owner = Brian. All tasks are associated to the deal via PUT /crm/v3/associations/tasks/{task_id}/deals/{deal_id}. Timezone: America/New_York. All secrets via env.VARIABLE_NAME."
  },
  "environment": {
    "HUBSPOT_DEAL_STAGE_CHANGE_WEBHOOK_ID": "env.HUBSPOT_DEAL_STAGE_CHANGE_WEBHOOK_ID",
    "HUBSPOT_PRIVATE_APP_TOKEN": "env.HUBSPOT_PRIVATE_APP_TOKEN",
    "HUBSPOT_OWNER_ID_BRIAN": "env.HUBSPOT_OWNER_ID_BRIAN",
    "HUBSPOT_STAGE_REPLIED": "env.HUBSPOT_STAGE_REPLIED",
    "HUBSPOT_STAGE_CALL_BOOKED": "env.HUBSPOT_STAGE_CALL_BOOKED",
    "HUBSPOT_STAGE_PROPOSAL_SENT": "env.HUBSPOT_STAGE_PROPOSAL_SENT",
    "HUBSPOT_STAGE_CLOSED_LOST": "env.HUBSPOT_STAGE_CLOSED_LOST",
    "RESEND_API_KEY": "env.RESEND_API_KEY",
    "ALERT_EMAIL": "env.ALERT_EMAIL",
    "CWI_ALERT_FROM_ADDRESS": "env.CWI_ALERT_FROM_ADDRESS"
  }
}
