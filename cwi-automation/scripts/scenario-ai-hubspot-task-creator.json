{
  "name": "scenario-ai-hubspot-task-creator",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "{{env.HUBSPOT_DEAL_STAGE_CHANGE_WEBHOOK_ID}}",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": {
              "label": "HubSpot Webhook — Deal Property Change (dealstage)"
            }
          }
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "label": "Maximum number of results"
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://api.hubapi.com/crm/v3/objects/deals/{{1.body.objectId}}?properties=dealname,hubspot_owner_id",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{env.HUBSPOT_PRIVATE_APP_TOKEN}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "body": "",
        "timeout": 30,
        "followRedirects": true,
        "compress": true,
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "restore": {
          "expect": {
            "method": { "label": "GET" }
          }
        }
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://api.hubapi.com/crm/v3/objects/deals/{{1.body.objectId}}/associations/contacts",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{env.HUBSPOT_PRIVATE_APP_TOKEN}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "body": "",
        "timeout": 30,
        "followRedirects": true,
        "compress": true,
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "restore": {
          "expect": {
            "method": { "label": "GET" }
          }
        }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/{{3.data.results[].id}}?properties=firstname,lastname",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{env.HUBSPOT_PRIVATE_APP_TOKEN}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "body": "",
        "timeout": 30,
        "followRedirects": true,
        "compress": true,
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 },
        "restore": {
          "expect": {
            "method": { "label": "GET" }
          }
        }
      }
    },
    {
      "id": 5,
      "module": "builtin:SetVariable",
      "version": 1,
      "parameters": {},
      "mapper": {
        "name": "contactName",
        "scope": "roundtrip",
        "type": "text",
        "value": "{{ifempty(trim(concat(ifempty(4.data.properties.firstname; \"\"); \" \"; ifempty(4.data.properties.lastname; \"\"))); \"the contact\")}}"
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 }
      }
    },
    {
      "id": 6,
      "module": "builtin:SetVariable",
      "version": 1,
      "parameters": {},
      "mapper": {
        "name": "dealId",
        "scope": "roundtrip",
        "type": "text",
        "value": "{{1.body.objectId}}"
      },
      "metadata": {
        "designer": { "x": 1200, "y": 150 }
      }
    },
    {
      "id": 7,
