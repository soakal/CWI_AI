                    "name": "Authorization",
                    "value": "Bearer {{env.RESEND_API_KEY}}"
                  },
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "bodyType": "raw",
                "contentType": "application/json",
                "body": "{\"from\":\"{{env.CWI_ALERT_FROM_ADDRESS}}\",\"to\":[\"{{env.ALERT_EMAIL}}\"],\"subject\":\"Proposal sent to {{5.contactName}} — follow-up task created for 3 days\",\"text\":\"Proposal sent to {{5.contactName}} — follow-up task created for 3 days.\\n\\nDeal ID: {{6.dealId}}\\nTask ID: {{16.data.id}}\\nFollow-up due: {{formatDate(addDays(now; 3); 'MMMM D, YYYY'; 'America/New_York')}}\\n\\nGenerated by CWI AI Automation\"}",
                "timeout": 30,
                "followRedirects": true,
                "compress": true,
                "parseResponse": true
              },
              "metadata": {
                "designer": { "x": 2700, "y": 200 },
                "restore": {
                  "expect": {
                    "method": { "label": "POST" }
                  }
                }
