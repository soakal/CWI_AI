                "data": "{\"api_key\":\"{{env.APOLLO_API_KEY}}\",\"contact_emails\":[\"{{1.contact_email}}\"],\"label_names\":[\"Not-Interested\"]}"
              },
              "metadata": {
                "designer": { "x": 2100, "y": 0 },
                "label": "Apollo: Tag Not-Interested"
              }
            }
          ],
          "label": "NEGATIVE",
          "filter": {
            "name": "Sentiment is Negative",
            "conditions": [
