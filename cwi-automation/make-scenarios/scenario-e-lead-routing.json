                ],
                "queryString": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "data": "{\"from\":\"{{env.CWI_ALERT_FROM_ADDRESS}}\",\"to\":[\"brian@cwiai.net\"],\"subject\":\"[CWI ALERT] Unrecognized reply sentiment — manual review needed\",\"html\":\"<p>Hi Brian,</p><p>The Lead Reply Routing scenario received a reply that did not classify cleanly as positive, negative, or neutral (e.g. the classifier returned an unexpected value such as 'Positive.' with punctuation). The lead was NOT auto-handled and needs manual review.</p><hr><p><strong>Contact name:</strong> {{1.contact_name}}<br><strong>Contact email:</strong> {{1.contact_email}}<br><strong>Sequence step:</strong> {{1.sequence_step}}</p><p><strong>Original reply text:</strong></p><blockquote>{{1.reply_text}}</blockquote><p><strong>Raw Claude classifier output:</strong></p><pre>{{2.data.choices[0].message.content}}</pre><p><strong>Normalized value evaluated:</strong> {{3.value}}</p><hr><p>Action: review the raw output above and follow up with this lead manually.</p><p>— CWI Automation (Scenario E)</p>\"}"
              },
              "metadata": {
                "designer": { "x": 1200, "y": 600 },
                "label": "Resend: Internal Alert — Unclassified Reply (Fallback)"
              }
            },
            {
              "id": 16,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://api.apollo.io/v1/contact/bulk_attributes_update",
                "serializeUrl": false,
