          }
        },
        {
          "flow": [
            {
              "id": 12,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://api.resend.com/emails",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer {{env.RESEND_API_KEY}}" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "queryString": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "data": "{\"from\":\"{{env.RESEND_FROM_ADDRESS}}\",\"to\":[\"{{1.contact_email}}\"],\"subject\":\"Re: Quick Clarification — Happy to Find a Good Time\",\"html\":\"<p>Hi {{1.contact_name}},</p><p>Thanks for the reply! I want to make sure I understand where you're coming from so I can be as helpful as possible.</p><p>If you'd like to explore how CWI could support your business, I'd love to set aside 20 minutes for a no-pressure conversation. Feel free to pick a slot that's convenient for you:</p><p><a href=\\\"https://cwiai.net/demo.html\\\" style=\\\"background-color:#0066cc;color:#ffffff;padding:10px 20px;text-decoration:none;border-radius:4px;display:inline-block;\\\">Pick a Time on My Calendar</a></p><p>Alternatively, if now isn't the right time or you have a specific question, just hit reply and let me know — I'm happy to follow up at a better moment.</p><p>Best,<br>The CWI Team<br><a href=\\\"mailto:brian@cwiai.net\\\">brian@cwiai.net</a></p>\"}"
              },
