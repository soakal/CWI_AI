{
  "name": "Scenario E: Lead Reply Routing",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 1001,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": {
              "label": "Apollo Webhook - email.reply_received",
              "data": {
                "editable": true
              }
            }
          }
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "label": "Maximum number of results"
          }
        ],
        "interface": [
          { "name": "contact_email", "type": "text", "label": "Contact Email" },
          { "name": "contact_name", "type": "text", "label": "Contact Name" },
          { "name": "reply_text", "type": "text", "label": "Reply Text" },
          { "name": "sequence_step", "type": "text", "label": "Sequence Step" }
        ],
        "label": "Apollo Webhook: email.reply_received"
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{env.OPENROUTER_API_KEY}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "HTTP-Referer",
            "value": "https://cwi-automation.make.com"
          },
          {
            "name": "X-Title",
            "value": "CWI Lead Reply Routing"
          }
        ],
        "queryString": [],
        "bodyType": "raw",
        "parseResponse": true,
        "authUser": "",
        "authPass": "",
        "timeout": 30,
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "contentType": "application/json",
        "data": "{\"model\":\"anthropic/claude-sonnet-4-6\",\"messages\":[{\"role\":\"system\",\"content\":\"You are a reply sentiment classifier. Respond with exactly one word only — no punctuation, no explanation. The word must be one of: positive, negative, neutral. Positive = interested, wants to talk, asking for a meeting, or expressing enthusiasm. Negative = unsubscribe, stop, remove me, not interested, or any opt-out request. Neutral = out of office, unclear, ambiguous, or requires follow-up.\"},{\"role\":\"user\",\"content\":\"Classify this email reply from {{1.contact_name}}: {{1.reply_text}}\"}],\"max_tokens\":5,\"temperature\":0}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "label": "OpenRouter: Classify Reply Sentiment"
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{2.data.choices[0].message.content}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "label": "Extract Sentiment Value"
      }
    },
    {
      "id": 4,
      "module": "builtin:RouterModule",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 900, "y": 0 },
        "label": "Route by Sentiment"
      },
      "routes": [
        {
          "flow": [
            {
              "id": 101,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer {{env.HUBSPOT_PRIVATE_APP_TOKEN}}" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "queryString": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "data": "{\"filterGroups\":[{\"filters\":[{\"propertyName\":\"email\",\"operator\":\"EQ\",\"value\":\"{{1.contact_email}}\"}]}],\"properties\":[\"email\",\"firstname\",\"lastname\"],\"limit\":1}"
              },
              "metadata": {
                "designer": { "x": 1200, "y": -450 },
                "label": "HubSpot: Search Contact by Email (Positive)"
              }
            },
            {
              "id": 102,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://api.hubapi.com/crm/v3/objects/deals/search",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer {{env.HUBSPOT_PRIVATE_APP_TOKEN}}" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "queryString": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "data": "{\"filterGroups\":[{\"filters\":[{\"propertyName\":\"associations.contact\",\"operator\":\"EQ\",\"value\":\"{{101.data.results[0].id}}\"}]}],\"properties\":[\"dealname\",\"dealstage\",\"hs_object_id\"],\"limit\":1}"
              },
              "metadata": {
                "designer": { "x": 1200, "y": -360 },
                "label": "HubSpot: Search Deal by Contact ID (Positive)"
              }
            },
            {
              "id": 5,
              "module": "hubspot:ActionUpdateDeal",
              "version": 1,
              "parameters": {
                "portalId": "{{env.HUBSPOT_PORTAL_ID}}"
              },
              "mapper": {
                "dealId": "{{102.data.results[0].id}}",
                "properties": [
                  {
                    "name": "dealstage",
                    "value": "{{env.HUBSPOT_STAGE_REPLIED}}"
                  },
                  {
                    "name": "hs_lead_status",
                    "value": "IN_PROGRESS"
                  },
                  {
                    "name": "reply_sentiment",
                    "value": "positive"
                  },
                  {
                    "name": "last_reply_date",
                    "value": "{{now}}"
                  }
                ]
              },
              "metadata": {
                "designer": { "x": 1200, "y": -300 },
                "label": "HubSpot: Move Deal to Replied"
              }
            },
            {
              "id": 6,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://api.resend.com/emails",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer {{env.RESEND_API_KEY}}" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "queryString": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "data": "{\"from\":\"{{env.RESEND_FROM_ADDRESS}}\",\"to\":[\"{{1.contact_email}}\"],\"subject\":\"Re: Let's Connect — Schedule Time to Chat\",\"html\":\"<p>Hi {{1.contact_name}},</p><p>Thank you so much for getting back to me — I'm really glad to hear you're open to connecting!</p><p>I'd love to set up a quick call to learn more about your goals and share how CWI has helped similar businesses. You can grab a time that works best for you directly on my calendar:</p><p><a href=\\\"https://cwiai.net/demo.html\\\" style=\\\"background-color:#0066cc;color:#ffffff;padding:10px 20px;text-decoration:none;border-radius:4px;display:inline-block;\\\">Schedule a Discovery Call</a></p><p>The call typically runs 20-30 minutes and is completely pressure-free. Looking forward to speaking with you!</p><p>Best regards,<br>The CWI Team<br><a href=\\\"mailto:brian@cwiai.net\\\">brian@cwiai.net</a></p>\"}"
              },
              "metadata": {
                "designer": { "x": 1500, "y": -300 },
                "label": "Resend: Send Calendar Link (Positive)"
              }
            },
            {
              "id": 7,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://api.apollo.io/v1/contact/bulk_attributes_update",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Content-Type", "value": "application/json" },
                  { "name": "X-Api-Key", "value": "{{env.APOLLO_API_KEY}}" }
                ],
                "queryString": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "data": "{\"api_key\":\"{{env.APOLLO_API_KEY}}\",\"contact_emails\":[\"{{1.contact_email}}\"],\"label_names\":[\"Replied-Interested\"]}"
              },
              "metadata": {
                "designer": { "x": 1800, "y": -300 },
                "label": "Apollo: Tag Replied-Interested"
              }
            }
          ],
          "label": "POSITIVE",
          "filter": {
            "name": "Sentiment is Positive",
            "conditions": [
              [
                {
                  "a": "{{lower(3.value)}}",
                  "b": "positive",
                  "o": "text:equal"
                }
              ]
            ]
          }
        },
