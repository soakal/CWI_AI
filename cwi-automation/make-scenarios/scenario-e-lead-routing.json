                "queryString": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "data": "{\"from\":\"{{env.RESEND_FROM_ADDRESS}}\",\"to\":[\"{{1.contact_email}}\"],\"subject\":\"Re: You've Been Removed — No Further Emails\",\"html\":\"<p>Hi {{1.contact_name}},</p><p>Absolutely understood, and I sincerely apologize for any inconvenience. You have been immediately removed from all outreach sequences and will not receive any further emails from us.</p><p>We respect your time and your inbox. If you ever find yourself curious about what CWI offers in the future, please don't hesitate to reach out — we're always happy to help on your terms.</p><p>Wishing you all the best,<br>The CWI Team<br><a href=\\\"mailto:brian@cwiai.net\\\">brian@cwiai.net</a></p>\"}"
              },
