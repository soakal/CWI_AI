    {
      "id": 4,
      "module": "util:SetVariables2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "deal_id",
            "value": "{{3.id}}"
          },
          {
            "name": "dealname",
            "value": "{{3.properties.dealname}}"
          },
          {
            "name": "createdate",
            "value": "{{3.properties.createdate}}"
          },
          {
            "name": "num_contacted_notes",
            "value": "{{3.properties.num_contacted_notes}}"
          },
          {
            "name": "hs_lastmodifieddate",
            "value": "{{3.properties.hs_lastmodifieddate}}"
          },
          {
            "name": "deal_age_days",
            "value": "{{round(dateDifference(now; parseDate(3.properties.createdate; 'YYYY-MM-DDTHH:mm:ss.SSSZ'); 'days'))}}"
          },
          {
            "name": "hours_since_modified",
            "value": "{{round(dateDifference(now; parseDate(3.properties.hs_lastmodifieddate; 'YYYY-MM-DDTHH:mm:ss.SSSZ'); 'hours'))}}"
          },
          {
            "name": "score_contacted_24hr",
            "value": "{{if(round(dateDifference(now; parseDate(3.properties.hs_lastmodifieddate; 'YYYY-MM-DDTHH:mm:ss.SSSZ'); 'hours')) <= 24; 10; 0)}}"
          },
          {
            "name": "score_interactions",
            "value": "{{if(3.properties.num_contacted_notes > 2; 10; 0)}}"
          },
          {
            "name": "score_age_young",
            "value": "{{if(round(dateDifference(now; parseDate(3.properties.createdate; 'YYYY-MM-DDTHH:mm:ss.SSSZ'); 'days')) < 3; 10; 0)}}"
          },
          {
            "name": "score_age_old",
            "value": "{{if(round(dateDifference(now; parseDate(3.properties.createdate; 'YYYY-MM-DDTHH:mm:ss.SSSZ'); 'days')) > 7; -20; 0)}}"
          },
          {
            "name": "lead_score",
            "value": "{{50 + if(round(dateDifference(now; parseDate(3.properties.hs_lastmodifieddate; 'YYYY-MM-DDTHH:mm:ss.SSSZ'); 'hours')) <= 24; 10; 0) + if(3.properties.num_contacted_notes > 2; 10; 0) + if(round(dateDifference(now; parseDate(3.properties.createdate; 'YYYY-MM-DDTHH:mm:ss.SSSZ'); 'days')) < 3; 10; 0) + if(round(dateDifference(now; parseDate(3.properties.createdate; 'YYYY-MM-DDTHH:mm:ss.SSSZ'); 'days')) > 7; -20; 0)}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {},
        "parameters": [],
        "expect": [
          {
            "name": "variables",
            "type": "array",
            "label": "Variables"
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "routes": [
        {
          "name": "Hot Lead (score >= 70)",
          "flow": [6, 7],
          "filter": {
            "name": "lead_score >= 70",
            "conditions": [
              [
                {
                  "a": "{{4.lead_score}}",
                  "b": "70",
                  "o": "number:greaterThanOrEqual"
                }
              ]
            ]
          }
        },
        {
          "name": "Skip (score < 70)",
          "flow": [],
          "filter": {
            "name": "lead_score < 70",
            "conditions": [
              [
                {
                  "a": "{{4.lead_score}}",
                  "b": "70",
                  "o": "number:lessThan"
                }
              ]
            ]
          }
        }
      ],
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        },
        "restore": {}
      }
    },
    {
