    "OPENROUTER_API_KEY": "OpenRouter API key for Claude access",
    "OPENROUTER_REFERRER": "HTTP-Referer header value for OpenRouter requests",
    "RESEND_API_KEY": "Resend API key for sending emails",
    "CWI_ALERT_FROM_ADDRESS": "Verified sender address for alert emails (e.g. alerts@yourdomain.com)",
    "ADMIN_EMAIL": "Brian's email address for hot lead and error alerts"
