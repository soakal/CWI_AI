    "notes": [
      {
        "id": 1,
        "content": "Module 1: Schedule trigger — daily 9PM ET (America/New_York)",
        "position": { "x": 0, "y": -80 }
      },
      {
        "id": 2,
        "content": "Module 2: HubSpot HTTP POST search — New Lead stage, limit 50, properties: dealname, createdate, num_contacted_notes, hs_lastmodifieddate",
        "position": { "x": 300, "y": -80 }
      },
      {
        "id": 3,
        "content": "Module 3: Iterator — loops over each deal returned by HubSpot",
        "position": { "x": 600, "y": -80 }
      },
      {
        "id": 4,
        "content": "Module 4: SetVariable — calculates lead_score: base 50, +10 contacted last 24hr, +10 if notes > 2, +10 if age < 3 days, -20 if age > 7 days",
        "position": { "x": 900, "y": -80 }
      },
      {
