{
  "name": "Scenario N: Lead Scoring & Hot Lead Alert",
  "comments": "Runs every night at 9PM ET. Fetches deals in the New Lead stage from HubSpot (up to 50). Iterates over each deal and calculates a lead score: base 50, +10 if contacted in last 24 hours, +10 if num_contacted_notes > 2, +10 if deal age < 3 days, -20 if deal age > 7 days. A Router passes only leads scoring 70 or above to the next steps. Claude (OpenRouter, claude-sonnet-4-6) writes a 2-sentence hot lead alert message. Resend delivers the alert to the admin. An error handler sends a Resend alert on any failure. All secrets are stored as env.VARIABLE_NAME. Timezone: America/New_York.",
  "flow": [
    {
      "id": 1,
      "module": "util:SetVariables2",
      "version": 1,
      "parameters": {},
      "scheduler": {
        "type": "cron",
        "cron": "0 21 * * *",
        "timezone": "America/New_York"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {},
        "parameters": [],
        "expect": []
      },
      "module": "builtin:BasicTrigger",
      "version": 1,
      "parameters": {
        "type": "schedule",
        "interval": "day",
        "time": "21:00",
        "timezone": "America/New_York"
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDecompression": true
      },
      "mapper": {
        "url": "https://api.hubapi.com/crm/v3/objects/deals/search",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{env.HUBSPOT_API_KEY}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "authUser": "",
        "authPass": "",
        "timeout": 30,
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "contentType": "application/json",
        "data": "{\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"dealstage\",\n          \"operator\": \"EQ\",\n          \"value\": \"{{env.HUBSPOT_STAGE_NEW_LEAD}}\"\n        }\n      ]\n    }\n  ],\n  \"properties\": [\n    \"dealname\",\n    \"createdate\",\n    \"num_contacted_notes\",\n    \"hs_lastmodifieddate\"\n  ],\n  \"limit\": 50\n}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {
          "expect": {
            "method": {
              "label": "POST"
            },
            "bodyType": {
              "label": "Raw"
            },
            "contentType": {
              "label": "JSON (application/json)"
            }
          }
        },
        "parameters": [
          {
            "name": "handleErrors",
            "type": "boolean",
            "label": "Evaluate all states as errors (except for 2xx and 3xx)",
            "required": true
          },
          {
            "name": "useNewZLibDecompression",
            "type": "boolean",
            "label": "Use new ZLib decompression library",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "url",
            "type": "url",
            "label": "URL",
            "required": true
          },
          {
            "name": "method",
            "type": "select",
            "label": "Method",
            "required": true
          },
          {
            "name": "headers",
            "type": "array",
            "label": "Headers"
          },
          {
            "name": "bodyType",
            "type": "select",
            "label": "Body type"
          },
          {
            "name": "contentType",
            "type": "select",
            "label": "Content type"
          },
          {
            "name": "data",
            "type": "string",
            "label": "Request content"
          },
          {
            "name": "parseResponse",
            "type": "boolean",
            "label": "Parse response"
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "util:Iterator",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{2.data.results}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {},
        "parameters": [],
        "expect": [
          {
            "name": "array",
            "type": "array",
            "label": "Array",
            "required": true
          }
