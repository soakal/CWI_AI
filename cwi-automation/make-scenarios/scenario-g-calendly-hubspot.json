{
  "name": "Scenario G: Calendly to HubSpot Sync",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 2001,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "parameters": {
            "hook": {
              "label": "Calendly Booking Webhook - invitee.created",
              "data": {
                "editable": true
              }
            }
          }
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "label": "Maximum number of results"
          }
        ],
        "label": "Calendly Webhook: invitee.created"
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "method": "POST",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{env.HUBSPOT_API_KEY}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "body": "{\"filterGroups\":[{\"filters\":[{\"propertyName\":\"email\",\"operator\":\"EQ\",\"value\":\"{{1.body.payload.invitee.email}}\"}]}],\"properties\":[\"email\",\"firstname\",\"lastname\",\"hs_object_id\"]}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {
          "expect": {
            "method": {
              "label": "POST"
            },
            "bodyType": {
              "label": "Raw"
            },
            "contentType": {
              "label": "JSON (application/json)"
            }
          }
        }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://api.hubapi.com/crm/v3/objects/deals/search",
        "method": "POST",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{env.HUBSPOT_API_KEY}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "body": "{\"filterGroups\":[{\"filters\":[{\"propertyName\":\"associations.contact\",\"operator\":\"EQ\",\"value\":\"{{2.data.results[0].id}}\"}]}],\"properties\":[\"dealname\",\"dealstage\",\"hs_object_id\"],\"limit\":1}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {
          "expect": {
            "method": {
              "label": "POST"
            },
            "bodyType": {
              "label": "Raw"
            },
            "contentType": {
              "label": "JSON (application/json)"
            }
          }
        }
      }
    },
    {
      "id": 10,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 11,
              "module": "builtin:BasicFeeder",
              "version": 1,
              "parameters": {},
              "filter": {
                "name": "Deal Exists",
                "conditions": [
                  [
                    {
                      "a": "{{4.data.results[0].id}}",
                      "o": "exist"
                    }
                  ]
                ]
              },
              "mapper": {},
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": -150
                }
              }
            },
            {
              "id": 5,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://api.hubapi.com/crm/v3/objects/deals/{{4.data.results[0].id}}",
                "method": "PATCH",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer {{env.HUBSPOT_API_KEY}}"
                  },
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "body": "{\"properties\":{\"dealstage\":\"{{env.HUBSPOT_STAGE_CALL_BOOKED}}\"}}"
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": -150
                },
                "restore": {
                  "expect": {
                    "method": {
                      "label": "PATCH"
                    },
                    "bodyType": {
                      "label": "Raw"
                    },
                    "contentType": {
                      "label": "JSON (application/json)"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 12,
              "module": "builtin:BasicFeeder",
              "version": 1,
              "parameters": {},
              "filter": {
                "name": "No Deal Found",
                "conditions": [
                  [
                    {
                      "a": "{{4.data.results[0].id}}",
                      "o": "notexist"
                    }
                  ]
                ]
              },
              "mapper": {},
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 150
                }
              }
            },
            {
              "id": 13,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://api.hubapi.com/crm/v3/objects/deals",
                "method": "POST",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer {{env.HUBSPOT_API_KEY}}"
                  },
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "body": "{\"properties\":{\"dealname\":\"Discovery Call - {{1.body.payload.invitee.name}}\",\"dealstage\":\"{{env.HUBSPOT_STAGE_CALL_BOOKED}}\",\"pipeline\":\"{{env.HUBSPOT_PIPELINE_ID}}\"},\"associations\":[{\"to\":{\"id\":\"{{2.data.results[0].id}}\"},\"types\":[{\"associationCategory\":\"HUBSPOT_DEFINED\",\"associationTypeId\":3}]}]}"
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": 150
                },
                "restore": {
                  "expect": {
                    "method": {
                      "label": "POST"
                    },
                    "bodyType": {
                      "label": "Raw"
                    },
                    "contentType": {
                      "label": "JSON (application/json)"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": 6,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://api.hubapi.com/crm/v3/objects/notes",
        "method": "POST",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{env.HUBSPOT_API_KEY}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "body": "{\"properties\":{\"hs_note_body\":\"Discovery call booked: {{1.body.payload.event.name}} on {{1.body.payload.event.start_time}} via Calendly. Invitee: {{1.body.payload.invitee.name}} ({{1.body.payload.invitee.email}})\",\"hs_timestamp\":\"{{1.body.payload.event.start_time}}\"},\"associations\":[{\"to\":{\"id\":\"{{2.data.results[0].id}}\"},\"types\":[{\"associationCategory\":\"HUBSPOT_DEFINED\",\"associationTypeId\":202}]},{\"to\":{\"id\":\"{{ifempty(4.data.results[0].id; 13.data.id)}}\"},\"types\":[{\"associationCategory\":\"HUBSPOT_DEFINED\",\"associationTypeId\":214}]}]}"
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        },
        "restore": {
          "expect": {
            "method": {
              "label": "POST"
            },
            "bodyType": {
              "label": "Raw"
            },
            "contentType": {
              "label": "JSON (application/json)"
            }
          }
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us2.make.com"
  },
  "connections": {
    "hubspot": {
      "label": "HubSpot CWI Account",
      "scopes": ["crm.objects.deals.write", "crm.objects.deals.read", "crm.objects.contacts.read"]
    }
  },
  "environment_variables": {
    "HUBSPOT_API_KEY": "REPLACE_WITH_HUBSPOT_PRIVATE_APP_TOKEN",
    "HUBSPOT_STAGE_CALL_BOOKED": "REPLACE_WITH_HUBSPOT_CALL_BOOKED_STAGE_ID",
    "HUBSPOT_PIPELINE_ID": "REPLACE_WITH_HUBSPOT_PIPELINE_ID"
  },
  "webhooks": [
    {
      "id": 2001,
      "name": "Calendly Booking Webhook",
      "url": "GENERATED_BY_MAKE_ON_IMPORT",
      "method": "POST",
      "headers": [],
      "stringify": false,
      "retrieval": "lastdup",
      "type": "gateway",
      "json": true,
      "typedConfig": null,
      "rawConfig": null,
      "note": "Paste this URL into Calendly > Integrations > Webhooks > invitee.created"
    }
  ]
}
