            "required": true
          },
          {
            "name": "useNewZLibDecompression",
            "type": "boolean",
            "label": "Use new ZLib decompression library",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "url",
            "type": "url",
            "label": "URL",
            "required": true
          },
          {
            "name": "method",
            "type": "select",
            "label": "Method",
            "required": true
          },
