      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "client_name",
            "value": "{{3.value[0]}}"
          },
          {
            "name": "client_email",
            "value": "{{3.value[1]}}"
          },
          {
            "name": "hubspot_company_id",
            "value": "{{3.value[2]}}"
          },
          {
            "name": "last_activity_date",
            "value": "{{3.value[3]}}"
          },
          {
            "name": "containment_rate",
            "value": "{{toNumber(3.value[4])}}"
          },
          {
            "name": "monthly_fee",
            "value": "{{3.value[5]}}"
          },
          {
            "name": "days_since_activity",
            "value": "{{round(dateDifference(now; parseDate(3.value[3]; 'YYYY-MM-DD'); 'days'))}}"
          },
          {
            "name": "at_risk",
            "value": "{{if(round(dateDifference(now; parseDate(3.value[3]; 'YYYY-MM-DD'); 'days')) > 14 OR toNumber(3.value[4]) < 60; true; false)}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {},
        "parameters": [],
        "expect": [
