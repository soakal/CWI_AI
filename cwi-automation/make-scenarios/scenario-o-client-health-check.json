      "version": 1,
      "parameters": {},
      "mapper": {},
      "routes": [
        {
          "name": "At-Risk Client (alert required)",
          "flow": [6, 7, 8],
          "filter": {
            "name": "at_risk = true",
            "conditions": [
              [
                {
                  "a": "{{4.at_risk}}",
                  "b": "true",
                  "o": "text:equal"
                }
              ]
            ]
          }
        },
        {
          "name": "Healthy Client (skip)",
          "flow": [],
          "filter": {
            "name": "at_risk = false",
            "conditions": [
              [
                {
                  "a": "{{4.at_risk}}",
                  "b": "false",
                  "o": "text:equal"
                }
              ]
            ]
          }
        }
      ],
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        },
        "restore": {}
