    "notes": [
      {
        "id": 1,
        "content": "Module 1: Schedule trigger — 1st of every month at 9AM ET (America/New_York). Cron: 0 9 1 * *",
        "position": { "x": 0, "y": -80 }
      },
      {
        "id": 2,
        "content": "Module 2: Google Sheets HTTP GET — fetches all rows from ActiveClients tab of env.ACTIVE_CLIENTS_SHEET_ID. Columns: client_name, client_email, hubspot_company_id, last_activity_date, containment_rate, monthly_fee",
        "position": { "x": 300, "y": -80 }
      },
      {
        "id": 3,
        "content": "Module 3: Iterator — loops over each client row (skips header row via slice). Each item is a value array indexed 0-5.",
        "position": { "x": 600, "y": -80 }
      },
      {
        "id": 4,
        "content": "Module 4: SetVariables — maps row columns to named vars, calculates days_since_activity (dateDifference from last_activity_date to now), sets at_risk = true if days_since_activity > 14 OR containment_rate < 60",
        "position": { "x": 900, "y": -80 }
      },
      {
        "id": 5,
        "content": "Module 5: Router — at_risk = true proceeds to alert path (modules 6-8); at_risk = false is discarded silently",
        "position": { "x": 1200, "y": -80 }
      },
      {
        "id": 6,
        "content": "Module 6: HubSpot HTTP PATCH — updates CWI_Last_CheckIn property to today (YYYY-MM-DD) on the company identified by hubspot_company_id",
        "position": { "x": 1500, "y": -230 }
      },
      {
        "id": 7,
        "content": "Module 7: OpenRouter HTTP POST — model anthropic/claude-sonnet-4-6 — generates 2-sentence at-risk alert for client, including days_since_activity and containment_rate, with one suggested action for Brian",
        "position": { "x": 1800, "y": -230 }
      },
      {
        "id": 8,
        "content": "Module 8: Resend HTTP POST — sends at-risk alert email from env.CWI_ALERT_FROM_ADDRESS to env.ADMIN_EMAIL. Subject: 'At-Risk Client Alert: [client_name]'. Body includes Claude alert, client email, and monthly fee.",
        "position": { "x": 2100, "y": -230 }
      },
      {
        "id": 9,
        "content": "Module 9: Error Handler — Resend alert to admin on any scenario failure, including error message and module name",
        "position": { "x": 900, "y": 220 }
      }
    ]
  },
  "environment_variables": {
    "ACTIVE_CLIENTS_SHEET_ID": "Google Sheets spreadsheet ID containing the ActiveClients tab",
    "GOOGLE_SHEETS_API_KEY": "Google Sheets API bearer token (service account or OAuth2 access token)",
    "HUBSPOT_API_KEY": "HubSpot private app bearer token",
    "OPENROUTER_API_KEY": "OpenRouter API key for Claude access",
    "OPENROUTER_REFERRER": "HTTP-Referer header value for OpenRouter requests",
    "RESEND_API_KEY": "Resend API key for sending emails",
    "CWI_ALERT_FROM_ADDRESS": "Verified sender address for alert emails (e.g. alerts@yourdomain.com)",
    "ADMIN_EMAIL": "Brian's email address for at-risk client and error alerts"
  }
}
