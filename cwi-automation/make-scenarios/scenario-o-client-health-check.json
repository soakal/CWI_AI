{
  "name": "Scenario O: Monthly Client Health Check",
  "comments": "Runs on the 1st of every month at 9AM ET. Fetches all rows from the ActiveClients tab of the Google Sheet defined by env.ACTIVE_CLIENTS_SHEET_ID. Iterates over each client and calculates days_since_activity and an at_risk flag (true if days_since_activity > 14 OR containment_rate < 60). A Router passes only at-risk clients forward. For each at-risk client, HubSpot is updated with today as CWI_Last_CheckIn, Claude (OpenRouter, claude-sonnet-4-6) writes a 2-sentence internal alert with one suggested action, and Resend delivers the alert to the admin. An error handler sends a Resend alert on any failure. All secrets are stored as env.VARIABLE_NAME. Timezone: America/New_York.",
  "flow": [
    {
      "id": 1,
      "module": "builtin:BasicTrigger",
      "version": 1,
      "parameters": {
        "type": "schedule",
        "cron": "0 9 1 * *",
        "timezone": "America/New_York"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {},
        "parameters": [
          {
            "name": "type",
            "type": "select",
            "label": "Trigger type",
            "required": true
          },
          {
            "name": "cron",
            "type": "text",
            "label": "Cron expression",
            "required": true
          },
          {
            "name": "timezone",
            "type": "timezone",
            "label": "Timezone",
            "required": true
          }
        ],
        "expect": []
      }
    },
    {
