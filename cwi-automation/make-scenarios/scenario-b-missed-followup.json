  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us1.make.com"
  },
  "connections": {
    "freshchat": {
      "label": "Freshchat API Connection",
      "type": "http",
      "apiToken": "{{env.FRESHCHAT_API_TOKEN}}",
      "botAgentId": "{{env.FRESHCHAT_BOT_AGENT_ID}}",
      "baseUrl": "https://api.freshchat.com/v2"
