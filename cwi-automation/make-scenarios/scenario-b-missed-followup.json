        "bodyType": "raw",
        "contentType": "application/json",
        "body": "{\n  \"model\": \"anthropic/claude-sonnet-4-6\",\n  \"models\": [\"anthropic/claude-sonnet-4-6\", \"anthropic/claude-3-5-sonnet\", \"openai/gpt-4o-mini\"],\n  \"route\": \"fallback\",\n  \"provider\": {\n    \"allow_fallbacks\": true\n  },\n  \"max_tokens\": 150,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a friendly customer support assistant for CWI. Write concise, warm follow-up emails. Keep responses under 50 words. Be professional yet approachable.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a brief 50-word follow-up email to {{4.body.first_name}} {{4.body.last_name}} who reached out but hasn't received a human response yet. Reference their inquiry and offer to help. Subject line not needed — body only.\"\n    }\n  ]\n}",
        "parseResponse": true
