{
  "name": "Scenario B: Missed Inquiry Follow-Up",
  "flow": [
    {
      "id": 1,
      "module": "builtin:BasicTrigger",
      "version": 1,
      "parameters": {
        "interval": 1800
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {}
      },
      "scheduling": {
        "type": "interval",
        "interval": 1800
      },
      "trigger": {
        "type": "schedule"
      },
      "label": "Every 30 Minutes"
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://api.freshchat.com/v2/conversations?status=open&assigned_agent_type=bot&page_size=50",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{env.FRESHCHAT_API_TOKEN}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "qs": [
          {
            "name": "status",
            "value": "open"
          },
          {
            "name": "assigned_agent_type",
            "value": "bot"
          },
          {
            "name": "created_before",
            "value": "{{formatDate(addSeconds(now; -7200); 'YYYY-MM-DDTHH:mm:ssZ'; 'America/New_York')}}"
          }
        ],
        "bodyType": "",
        "parseResponse": true
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {
          "expect": {
            "method": {
              "label": "GET"
            },
            "bodyType": {
              "label": "Empty"
            }
          }
        },
        "expect": [
          {
            "name": "url",
            "type": "url",
            "label": "URL",
            "required": true
          },
          {
            "name": "method",
            "type": "select",
            "label": "Method",
            "required": true,
            "options": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          }
        ]
      },
      "onerror": [
        {
          "id": 20,
          "module": "http:ActionSendData",
          "version": 3,
          "parameters": {
            "handleErrors": true,
            "useNewZLibDeCompress": true
          },
          "mapper": {
            "url": "https://api.resend.com/emails",
            "method": "POST",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{env.RESEND_API_KEY}}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "bodyType": "raw",
            "contentType": "application/json",
            "body": "{\n  \"from\": \"{{env.CWI_ALERT_FROM_ADDRESS}}\",\n  \"to\": [\"brian@cwiai.net\"],\n  \"reply_to\": \"brian@cwiai.net\",\n  \"subject\": \"Scenario B Error — Freshchat List Conversations\",\n  \"text\": \"An error occurred while listing bot-assigned open conversations in Scenario B: Missed Inquiry Follow-Up.\\n\\nTimestamp: {{formatDate(now; 'YYYY-MM-DD HH:mm:ss'; 'America/New_York')}} America/New_York\\nError Message: {{2.error.message}}\\nError Code: {{2.error.code}}\\nScenario: Scenario B: Missed Inquiry Follow-Up\\nOwner: brian@cwiai.net / (734) 812-9971\"\n}",
            "parseResponse": true
          },
          "metadata": {
            "designer": {
              "x": 300,
              "y": 300
            },
            "restore": {
              "expect": {
                "method": {
                  "label": "POST"
                },
                "bodyType": {
                  "label": "Raw"
                },
                "contentType": {
                  "label": "JSON (application/json)"
                }
              }
            }
