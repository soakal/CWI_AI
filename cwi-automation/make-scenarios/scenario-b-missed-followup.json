          "label": "Resend: Alert — Freshchat List Failed"
        },
        {
          "id": 21,
          "module": "builtin:Commit",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": {
            "designer": {
              "x": 450,
              "y": 300
            },
            "restore": {}
          },
          "label": "Commit (stop run on list failure)"
        }
      ],
      "label": "Freshchat: List Bot-Assigned Open Conversations (>2h old)"
    },
    {
      "id": 3,
      "module": "builtin:BasicIterator",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{2.body.conversations}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {}
      },
      "label": "Iterate Unanswered Conversations"
    },
    {
      "id": 10,
      "module": "builtin:BasicFilter",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "Exclude Already-Followed-Up Conversations",
        "conditions": [
          [
            {
              "a": "{{join(map(3.value.labels; 'name'); ',')}}",
              "b": "follow-up-sent",
              "o": "text:notcontain"
            }
          ]
        ]
      },
      "metadata": {
        "designer": {
          "x": 750,
          "y": 0
        },
        "restore": {}
      },
      "label": "Filter: Skip if 'follow-up-sent' Label Present (Dedup at Start)"
    },
    {
