      "required": true
    },
    "RESEND_API_KEY": {
      "description": "Resend API key for sending transactional emails",
      "required": true
    },
    "RESEND_FROM_ADDRESS": {
      "description": "Verified Resend sender address used in the client-facing email 'from' field",
      "required": true
    },
    "CWI_ALERT_FROM_ADDRESS": {
      "description": "Verified Resend sender address used as 'from' for internal error/alert emails to the owner",
      "required": true
    },
    "RESEND_REPLY_TO": {
      "description": "Reply-to address applied to client-facing Resend emails so replies route to CWI",
      "required": true
    },
    "CALENDLY_LINK": {
      "description": "Calendly booking URL appended to follow-up emails so customers can self-schedule",
      "required": true
    }
  }
}
